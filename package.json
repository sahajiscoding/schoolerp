{
  "name": "schoolerp",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:mobile": "npm run dev --workspace=apps/mobile",
    "dev:admin": "npm run dev --workspace=apps/admin",
    "build:admin": "npm run build --workspace=apps/admin",
    "typecheck": "node scripts/typecheck-all.mjs",
    "lint": "npm run lint --workspaces --if-present",
    "verify:rls": "python3 supabase/tests/verify_rls_local.py"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "overrides": {
    "glob": "^14.0.3",
    "@expo/cli": {
      "glob": "^14.0.3"
    },
    "@expo/config": {
      "glob": "^14.0.3"
    },
    "@expo/config-plugins": {
      "glob": "^14.0.3"
    },
    "@expo/metro-config": {
      "glob": "^14.0.3"
    },
    "@expo/fingerprint": {
      "glob": "^14.0.3",
      "minimatch": "^11.0.4"
    },
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.4"
    },
    "@eslint/config-array": {
      "minimatch": "^10.2.6"
    }
  }
}
